# Test image of cmd/certmonitor: prints a certificate and every renewal of
# it (examples/shop/pod.yaml). Built and loaded into minikube by
# scripts/minikube_images.sh (make minikube-images); not published by CI.
FROM gcr.io/distroless/base-debian13:nonroot
LABEL org.opencontainers.image.source=https://github.com/effective-security/kubeca \
      org.opencontainers.image.authors="Effective Security <denis@tbilicode.com>" \
      org.opencontainers.image.url="https://github.com/effective-security/kubeca" \
      org.opencontainers.image.documentation="https://github.com/effective-security/kubeca" \
      org.opencontainers.image.vendor="Effective Security" \
      org.opencontainers.image.description="Kube CA certificate monitor (test)"

COPY ./bin/certmonitor ./change_log.txt /app/
WORKDIR /app

USER nonroot:nonroot

ENTRYPOINT ["/app/certmonitor"]
